---
import BaseLayout from './BaseLayout.astro';
import Sources from '../components/Sources.astro';
import { SITE, AUTHOR, topicLabel } from '../config';
import { fmtDate, isoDate, readingMinutes, type Post } from '../utils/posts';

interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const url = new URL(`/posts/${post.id}/`, Astro.site).href;
const modified = d.updatedAt ?? d.publishedAt;
const wasUpdated = !!d.updatedAt && isoDate(d.updatedAt) !== isoDate(d.publishedAt);
const image = d.ogImage ? new URL(d.ogImage, Astro.site).href : new URL(SITE.defaultOgImage, Astro.site).href;
const minutes = readingMinutes(post.body);

const author = {
  '@type': 'Person',
  name: AUTHOR.name,
  url: AUTHOR.url,
  ...(AUTHOR.jobTitle && { jobTitle: AUTHOR.jobTitle }),
  ...(AUTHOR.sameAs.length && { sameAs: AUTHOR.sameAs }),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    headline: d.title,
    description: d.excerpt,
    datePublished: d.publishedAt.toISOString(),
    dateModified: modified.toISOString(),
    inLanguage: SITE.language,
    image: [image],
    author,
    publisher: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
    isPartOf: { '@type': 'Blog', name: SITE.name, url: SITE.url },
    keywords: d.topics.map(topicLabel),
    articleSection: d.topics.length ? topicLabel(d.topics[0]) : undefined,
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    ...(d.sources.length && {
      citation: d.sources.map((s) => ({
        '@type': 'CreativeWork',
        name: s.title,
        url: s.url,
        ...(s.publisher && { publisher: { '@type': 'Organization', name: s.publisher } }),
        ...(s.year && { datePublished: String(s.year) }),
      })),
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Posts', item: SITE.url + '/posts/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<BaseLayout
  title={d.title}
  description={d.excerpt}
  type="article"
  image={d.ogImage}
  imageAlt={d.ogImageAlt}
  publishedTime={d.publishedAt}
  modifiedTime={modified}
  tags={d.topics.map(topicLabel)}
  jsonLd={jsonLd}
>
  <article>
    <!-- Full-width field carries the logo pattern; the header itself keeps the page width -->
    <div class="hero-field">
    <header class="post-header wrap">
      <h1>{d.title}</h1>
      <p class="dek">{d.excerpt}</p>
      <div class="meta">
        <span>By <strong>{AUTHOR.name}</strong></span>
        <span>Published <time datetime={isoDate(d.publishedAt)}>{fmtDate(d.publishedAt)}</time></span>
        {wasUpdated && <span>Updated <time datetime={isoDate(d.updatedAt!)}>{fmtDate(d.updatedAt!)}</time></span>}
        <span>{minutes} min read</span>
      </div>
      {d.topics.length > 0 && (
        <ul class="chips" aria-label="Topics">
          {d.topics.map((t) => <li><a href={`/topics/${t}/`}>{topicLabel(t)}</a></li>)}
        </ul>
      )}
    </header>
    </div>

    <div class="narrow">
    {d.ogImage && (
      <figure class="post-hero">
        <img src={d.ogImage} alt={d.ogImageAlt ?? ''} width="1200" height="630" fetchpriority="high" decoding="async" />
      </figure>
    )}

    <div class="prose"><slot /></div>

    <Sources sources={d.sources} />

    <aside class="author-box" aria-labelledby="about-author">
      <h2 id="about-author">About the author</h2>
      <p><strong>{AUTHOR.name}.</strong> {AUTHOR.bio} <a href="/about/">More about me</a>.</p>
    </aside>
    </div>
  </article>
</BaseLayout>

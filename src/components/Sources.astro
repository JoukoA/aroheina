---
interface Source { title: string; url: string; publisher?: string; year?: string | number }
interface Props { sources: Source[] }
const { sources } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Sources</h2>
    <ol>
      {sources.map((s, i) => (
        <li id={`source-${i + 1}`}>
          <a href={s.url} rel="noopener">{s.title}</a>{s.publisher && `. ${s.publisher}`}{s.year && `, ${s.year}`}.
        </li>
      ))}
    </ol>
  </section>
)}

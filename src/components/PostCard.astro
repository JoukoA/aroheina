---
import { fmtDate, isoDate, type Post } from '../utils/posts';
import { topicLabel } from '../config';
interface Props { post: Post; level?: 2 | 3 }
const { post, level = 2 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const d = post.data;
---
<li>
  <article>
    <div class="meta">
      <time datetime={isoDate(d.publishedAt)}>{fmtDate(d.publishedAt)}</time>
      {d.topics.length > 0 && <span>{d.topics.map(topicLabel).join(', ')}</span>}
    </div>
    <H><a href={`/posts/${post.id}/`}>{d.title}</a></H>
    <p>{d.excerpt}</p>
  </article>
</li>

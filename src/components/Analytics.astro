---
// Privacy-friendly analytics, switched by PUBLIC_ environment variables (see .env.example).
// Values are public by design (they appear in page HTML), so they are not secrets.
const provider = (import.meta.env.PUBLIC_ANALYTICS_PROVIDER ?? '').trim().toLowerCase();
const id = (import.meta.env.PUBLIC_ANALYTICS_ID ?? '').trim();
const domain = new URL(import.meta.env.SITE ?? 'https://aroheina.online').hostname;
---
{provider === 'goatcounter' && id && (
  <script is:inline data-goatcounter={`https://${id}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>
)}
{provider === 'cloudflare' && id && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: id })}></script>
)}
{provider === 'plausible' && (
  <script is:inline defer data-domain={domain} src="https://plausible.io/js/script.js"></script>
)}
{provider === 'umami' && id && (
  <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={id}></script>
)}

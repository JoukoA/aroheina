---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS } from '../../config';
import { getPosts } from '../../utils/posts';
const posts = await getPosts();
const count = (slug: string) => posts.filter((p) => p.data.topics.includes(slug)).length;
---
<BaseLayout title="Topics" description="Explore insights on emissions, energy, regulation and industrial performance.">
  <div class="hero-field">
    <header class="page-header wrap">
      <h1>Topics</h1>
      <p class="dek">A closer look at the evolving relationship between emissions, regulation, technology and industrial operations. Explore the topics, methods and developments shaping the energy sector.</p>
    </header>
  </div>
  <div class="wrap">
    <ul class="topic-grid">
      {TOPICS.map((t) => (
        <li>
          {count(t.slug) > 0
            ? <><a href={`/topics/${t.slug}/`}>{t.label}</a> ({count(t.slug)})</>
            : <span>{t.label} (coming soon)</span>}
          <p>{t.description}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, AUTHOR, TOPICS } from '../config';
import { getPosts } from '../utils/posts';

const posts = (await getPosts()).slice(0, 6);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE.url}/#blog`,
    name: SITE.name,
    description: SITE.description,
    url: SITE.url + '/',
    inLanguage: SITE.language,
    author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url + '/',
  },
];
---
<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <div class="narrow">
    <h1>{SITE.tagline}</h1>
    <p class="dek">{SITE.description}</p>

    <div class="section-head"><h2>Latest posts</h2><a href="/posts/">All posts</a></div>
    <ul class="post-list">{posts.map((p) => <PostCard post={p} level={3} />)}</ul>

    <h2>Browse by topic</h2>
    <ul class="chips">{TOPICS.map((t) => <li><a href={`/topics/${t.slug}/`}>{t.label}</a></li>)}</ul>
  </div>
</BaseLayout>

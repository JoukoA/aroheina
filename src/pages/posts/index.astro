---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils/posts';
const posts = await getPosts();
---
<BaseLayout title="All posts" description="Every post on methane emissions, newest first.">
  <div class="narrow">
    <h1>All posts</h1>
    <ul class="post-list">{posts.map((p) => <PostCard post={p} />)}</ul>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SITE } from '../config';
const paragraphs = (AUTHOR.bioLong || AUTHOR.bio).split(/\n\s*\n/).map((x) => x.trim()).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: AUTHOR.url,
    description: AUTHOR.bio,
    ...(AUTHOR.photo && { image: new URL(AUTHOR.photo, Astro.site).href }),
    ...(AUTHOR.jobTitle && { jobTitle: AUTHOR.jobTitle }),
    ...(AUTHOR.sameAs.length && { sameAs: AUTHOR.sameAs }),
  },
};
---
<BaseLayout title={`About ${AUTHOR.name}`} description={AUTHOR.bio} image={AUTHOR.photo || undefined} imageAlt={AUTHOR.photo ? AUTHOR.photoAlt : undefined} jsonLd={jsonLd}>
  <div class="narrow prose">
    <h1>About {AUTHOR.name}</h1>
    {AUTHOR.photo && (
      <figure class="portrait">
        <img src={AUTHOR.photo} alt={AUTHOR.photoAlt} width="800" height="1000" fetchpriority="high" decoding="async" />
      </figure>
    )}
    {paragraphs.map((para) => <p>{para}</p>)}
     {AUTHOR.sameAs.length > 0 && (
      <>
        <h2>Elsewhere</h2>
        <ul>{AUTHOR.sameAs.map((u) => <li><a href={u} rel="me noopener">{u}</a></li>)}</ul>
      </>
    )}
  </div>
</BaseLayout>
